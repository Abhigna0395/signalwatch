# ─────────────────────────────────────────────────────────────────────────────
# SignalWatch — backend configuration
# Copy this file to `.env` and edit. NEVER commit a real `.env`.
# Every value below has a working default: the app runs with an empty .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default) — zero setup, ideal for the demo:
DATABASE_URL=sqlite:///./signalwatch.db
# PostgreSQL — same ORM code, just swap the URL:
# DATABASE_URL=postgresql+psycopg://signalwatch:signalwatch@localhost:5432/signalwatch

# ── Market data provider ─────────────────────────────────────────────────────
# DEMO_MODE=true  -> deterministic seeded provider (no network, no API key).
#                    Data is clearly labelled "DEMO DATA" in the UI.
# DEMO_MODE=false -> live provider selected by MARKET_PROVIDER below.
#                    Falls back to the demo provider if the key is missing or
#                    the upstream call fails, and says so in the UI.
DEMO_MODE=true

# One of: demo | finnhub
MARKET_PROVIDER=finnhub

# https://finnhub.io/  — free tier is enough for this app.
FINNHUB_API_KEY=

# Seconds to wait on an upstream provider call before giving up.
PROVIDER_TIMEOUT_SECONDS=6.0
PROVIDER_MAX_RETRIES=2

# ── Secondary provider (cross-source verification) ───────────────────────────
# When enabled, quotes are fetched from a second source and compared. If the
# two disagree by more than the tolerance, the UI shows "Data discrepancy".
ENABLE_CROSS_SOURCE_CHECK=true
# Percentage difference above which two sources are considered in conflict.
DISCREPANCY_TOLERANCE_PERCENT=0.75

# ── Data freshness thresholds (seconds) ──────────────────────────────────────
FRESHNESS_FRESH_SECONDS=90
FRESHNESS_RECENT_SECONDS=900
FRESHNESS_STALE_SECONDS=21600

# ── Caching / background refresh ─────────────────────────────────────────────
QUOTE_CACHE_TTL_SECONDS=45
HISTORY_CACHE_TTL_SECONDS=1800
NEWS_CACHE_TTL_SECONDS=600
# Redis is optional. Leave blank to use the in-process cache.
REDIS_URL=

ENABLE_BACKGROUND_REFRESH=true
BACKGROUND_REFRESH_SECONDS=60

# ── Attention score weights (must be tuned together; max total = 100) ────────
WEIGHT_PRICE_MOVE=25
WEIGHT_VOLUME_ANOMALY=20
WEIGHT_TECHNICAL=15
WEIGHT_NEWS=15
WEIGHT_VOLATILITY=15
WEIGHT_RECENCY=10

# Attention band cut-offs.
THRESHOLD_HIGH_ATTENTION=75
THRESHOLD_WATCH=45

# ── Sentiment ────────────────────────────────────────────────────────────────
# One of: keyword | llm
# `keyword` is deterministic, offline and free. `llm` uses Anthropic if a key
# is present and silently falls back to `keyword` otherwise.
SENTIMENT_PROVIDER=keyword
ANTHROPIC_API_KEY=

# ── Auth (demo user) ─────────────────────────────────────────────────────────
# The app ships with a single demo user so judges can open it and go. The auth
# layer is abstracted (app/auth.py) so a real provider can drop in.
DEMO_USER_EMAIL=demo@signalwatch.app
