# Frontend configuration (all optional).
# Copy to `.env` only if you need to override the defaults.

# Where the dev server proxies /api requests. Defaults to the local backend.
VITE_API_TARGET=http://127.0.0.1:8000

# Set only if you deploy the frontend separately from the API and cannot proxy.
# When empty, the app calls same-origin /api (the normal case).
# VITE_API_BASE_URL=
